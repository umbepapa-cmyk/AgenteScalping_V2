# Example .env for deployment (DO NOT commit real secrets)
# Copy to .env on the server and fill with real values, with strict permissions (chmod 600)

# IB Gateway (ib-gateway container credentials)
IB_USER=your_ib_username
IB_PASS=your_ib_password

# Bot runtime (scalping-bot service reads IB_HOST/IB_PORT/IB_CLIENT_ID from the container environment or this file)
IB_HOST=ib-gateway
IB_PORT=4001
IB_CLIENT_ID=1

# Optional: LLM and news API keys
GEMINI_API_KEY=
NEWSAPI_KEY=
MARKETAUX_API_KEY=

# Runtime flags
SCALPER_DRY_RUN=true
